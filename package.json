{
    "name": "humongous-style-game",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Humongous-style point-and-click adventure game. TypeScript + Vite + Phaser 3, runs in the browser.",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --host",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check:size": "node tools/check-dist.mjs",
        "e2e": "node e2e/playthrough.mjs",
        "ci": "npm test && npm run build && npm run check:size && npm run e2e",
        "art:placeholders": "python3 tools/make_placeholder_art.py",
        "art:generate": "node tools/generate-assets.mjs"
    },
    "dependencies": {
        "phaser": "3.90.0"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "openai": "^7.52.0",
        "playwright": "1.64.1",
        "sharp": "^0.35.5",
        "typescript": "6.0.3",
        "vite": "^8.0.8",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22"
    }
}
