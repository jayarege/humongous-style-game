{
    "name": "humongous-style-game",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Humongous-style point-and-click adventure game. TypeScript + Vite + Phaser 3, runs in the browser.",
    "scripts": {
        "dev": "vite --host",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --host",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "art:placeholders": "python3 tools/make_placeholder_art.py"
    },
    "dependencies": {
        "phaser": "3.90.0"
    },
    "devDependencies": {
        "typescript": "6.0.3",
        "vite": "^8.0.8",
        "vitest": "^5.0.5"
    }
}
